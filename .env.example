# Copy to .env and `set -a; source .env; set +a` (or export these yourself).

# AWS credentials and region for Amazon Bedrock (any standard AWS credential source works).
# Set AWS_PROFILE so every command (chat, evals, UI, deploy) uses the account you mean.
# AWS_PROFILE=your-profile
AWS_REGION=us-east-1

# Store: leave SHOP_DOMAIN empty to use the local mock catalog.
# Any Shopify store works over UCP MCP, no API key needed: your-store.myshopify.com
SHOP_DOMAIN=
# Your agent's UCP profile. The default is a Shopify-hosted test profile; host your own for production.
# UCP_AGENT_PROFILE=https://your-domain.com/ucp/agent-profile.json

# Models: "provider/name" or a Bedrock model / inference profile id. These are the defaults;
# use any model enabled in your account. The commerce agent runs short store requests and the monitor
# reads a short payload on a minority of turns, so a small, fast model fits both.
# MONITOR_MODEL and CLASSIFIER_MODEL must be Bedrock model ids (the "bedrock/" prefix is optional).
ADVISOR_MODEL=bedrock/global.anthropic.claude-sonnet-4-6
COMMERCE_MODEL=bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0
MONITOR_MODEL=bedrock/global.anthropic.claude-haiku-4-5-20251001-v1:0

# Second detection layer: a model that can only add flags to the regex's, in parallel with the advisor.
# CLASSIFIER=off keeps the regex alone.
CLASSIFIER=model
CLASSIFIER_MODEL=bedrock/global.openai.gpt-5.6-luna
# OpenAI models only: "none" turns reasoning off, which roughly halves latency for a task this small.
CLASSIFIER_REASONING_EFFORT=none
# Past this, the classifier is cut off and the turn goes to the monitor.
CLASSIFIER_TIMEOUT_S=4

# Business rules (code, not prompt).
DISCOUNT_CODES=WELCOME10:10
MAX_QTY_PER_LINE=6
# Refuse, in code, to add a part the fitment table rules out for the customer's vehicle.
# Turn it off only to demo what the prompt alone would do.
ENFORCE_FITMENT=true

# Browser UI (ui/streamlit_app.py): the RuntimeArn printed by `cdk deploy`. Leave empty to run locally.
# RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/parts_agent-XXXXXXXXXX

# Advanced. The defaults are fine.
# STORE_MODE=mock                    # "mock" or "shopify"; by default, shopify when SHOP_DOMAIN is set
# SESSION_DIR=./.agent/sessions      # where the advisor's conversations are saved, per session
# PARTS_DATA_DIR=./data              # catalog.json (mock store) and specs.json (service data)
